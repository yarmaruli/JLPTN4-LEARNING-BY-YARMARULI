type WeakItem = 
 record {
   accuracy: nat;
   correctCount: nat;
   itemId: text;
   itemType: text;
   masteryLevel: nat;
   wrongCount: nat;
 };
type VocabMasteryPublic = 
 record {
   correctCount: nat;
   lastCorrect: int;
   lastSeen: int;
   lastWrong: int;
   lookupCount: nat;
   masteryLevel: nat;
   seenCount: nat;
   status: MasteryStatus;
   vocabId: text;
   wrongCount: nat;
 };
type VocabDashboardStats = 
 record {
   highFrequency: nat;
   intermediate: nat;
   learning: nat;
   mastered: nat;
   strongItems: vec WeakItem;
   total: nat;
   untouched: nat;
   weakItems: vec WeakItem;
 };
type ScoreSummary = 
 record {
   kanjiScore: nat;
   overallN4ReadinessScore: nat;
   radicalScore: nat;
   readingScore: nat;
   vocabularyScore: nat;
 };
type ReadingSessionPublic = 
 record {
   durationSeconds: nat;
   kanjiFailures: vec text;
   score: nat;
   sessionId: text;
   timestamp: int;
   unknownWords: vec text;
   wordsLookedUp: vec text;
 };
type RadicalMasteryPublic = 
 record {
   correctCount: nat;
   lastSeen: int;
   masteryLevel: nat;
   radicalId: text;
   seenCount: nat;
   status: MasteryStatus;
   wrongCount: nat;
 };
type RadicalDashboardStats = 
 record {
   intermediate: nat;
   learning: nat;
   mastered: nat;
   total: nat;
   untouched: nat;
   weakItems: vec WeakItem;
 };
type MasteryStatus = 
 variant {
   Intermediate;
   Learning;
   Mastered;
   Untouched;
 };
type KanjiMasteryPublic = 
 record {
   correctCount: nat;
   kanjiId: text;
   lastCorrect: int;
   lastSeen: int;
   lastWrong: int;
   lookupCount: nat;
   masteryLevel: nat;
   seenCount: nat;
   status: MasteryStatus;
   wrongCount: nat;
 };
type KanjiDashboardStats = 
 record {
   highFrequency: nat;
   intermediate: nat;
   learning: nat;
   mastered: nat;
   strongItems: vec WeakItem;
   total: nat;
   untouched: nat;
   weakItems: vec WeakItem;
 };
type AdaptiveQuizSessionPublic = 
 record {
   completedAt: opt int;
   correctAnswers: nat;
   ratio: AdaptiveQuizRatio;
   sessionId: text;
   totalQuestions: nat;
 };
type AdaptiveQuizRatio = 
 record {
   kanjiPercent: nat;
   radicalPercent: nat;
   vocabularyPercent: nat;
 };
service : {
  completeAdaptiveSession: (sessionId: text, totalQuestions: nat,
   correctAnswers: nat) -> ();
  getKanjiDashboard: () -> (KanjiDashboardStats) query;
  getKanjiMastery: (kanjiId: text) -> (opt KanjiMasteryPublic) query;
  getRadicalDashboard: () -> (RadicalDashboardStats) query;
  getRadicalMastery: (radicalId: text) -> (opt RadicalMasteryPublic) query;
  getScoreSummary: () -> (ScoreSummary) query;
  getVocabDashboard: () -> (VocabDashboardStats) query;
  getVocabMastery: (vocabId: text) -> (opt VocabMasteryPublic) query;
  getWeakKanji: (topN: nat) -> (vec WeakItem) query;
  getWeakRadicals: (topN: nat) -> (vec WeakItem) query;
  getWeakVocab: (topN: nat) -> (vec WeakItem) query;
  listKanjiMastery: (offset: nat, limit: nat) ->
   (vec KanjiMasteryPublic) query;
  listReadingSessions: (limit: nat) -> (vec ReadingSessionPublic) query;
  saveReadingSession: (sessionId: text, score: nat, durationSeconds: 
   nat, wordsLookedUp: vec text, unknownWords: vec text, kanjiFailures:
   vec text) -> ();
  startAdaptiveSession: (sessionId: text, kanjiPercent: nat, vocabPercent:
   nat, radicalPercent: nat) -> (AdaptiveQuizSessionPublic);
  trackKanjiCorrect: (kanjiId: text) -> ();
  trackKanjiLookup: (kanjiId: text) -> ();
  trackKanjiSeen: (kanjiId: text) -> ();
  trackKanjiWrong: (kanjiId: text) -> ();
  trackRadicalCorrect: (radicalId: text) -> ();
  trackRadicalSeen: (radicalId: text) -> ();
  trackRadicalWrong: (radicalId: text) -> ();
  trackVocabCorrect: (vocabId: text) -> ();
  trackVocabLookup: (vocabId: text) -> ();
  trackVocabSeen: (vocabId: text) -> ();
  trackVocabWrong: (vocabId: text) -> ();
}
